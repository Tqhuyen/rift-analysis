# Copy to .env (gitignored) and fill in. Never commit real keys.
#
# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key (Project Settings -> API). Server-side only.
# It bypasses RLS, so never expose it to the browser or commit it.
SUPABASE_SERVICE_KEY=

# Optional fallback if you created write policies for the anon key.
# SUPABASE_KEY=
